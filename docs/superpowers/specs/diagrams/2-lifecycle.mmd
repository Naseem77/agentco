flowchart TD
  START(("New issue / feature<br/>GitHub or local CLI")) --> PM(("PM agent"))
  PM -->|"context + acceptance criteria"| TRI(("Triage agent"))

  TRI -->|"easy / known pattern"| JUN(("Junior Eng"))
  TRI -->|"hard / risky"| SEN(("Senior Eng"))
  TRI -->|"new design needed"| ARCH(("Architect"))
  ARCH -->|"design doc (ADR)<br/>human approves"| TRI2{"Re-size<br/>sub-tasks"}
  TRI2 --> JUN
  TRI2 --> SEN

  subgraph LOCAL["Everything here runs LOCALLY — nothing on GitHub yet"]
    JUN
    SEN
    JUN -.->|"stuck: escalate"| SEN
    PRE["Pre-flight gate:<br/>review rules · unit + e2e · lint · build<br/>new tests fail without fix · size guard"]
    SREV(("Blind review<br/>code only, always"))
    QA(("QA agent<br/>isolated"))
    LEAD(("Team Lead"))
    BACK["Back to the first floor:<br/>engineer fixes, full process runs again"]
  end

  JUN --> PRE
  SEN --> PRE
  PRE -->|"rule broken: fix first"| JUN
  PRE --> SREV
  PRE --> QA
  SREV --> LEAD
  QA -->|"QA report only"| LEAD

  LEAD -->|"any check failed<br/>(known problem)"| BACK
  BACK --> TRI
  LEAD -->|"critical or NEW"| HUMAN(("Human"))
  HUMAN -->|"approve / reject / guide"| LEAD

  LEAD ==>|"approved"| PR(("OPEN PR<br/>last step"))
  PR --> HREV(("Humans review<br/>+ merge"))
  HREV -.->|"real bug only"| BACK
  HREV -.->|"edge case"| SPLIT["Separate task<br/>own PR"]

  PR --> LIB(("Librarian"))
  HREV -.->|"comments saved as rules"| LIB
  BACK -.->|"lead comments saved as rules"| LIB
  HUMAN -.->|"decision saved as rule"| LIB

  style LOCAL fill:#f8f9fa,stroke:#868e96,stroke-dasharray: 5 5
  style PR fill:#ebfbee,stroke:#2f9e44,stroke-width:3px
  style QA fill:#fff4e6,stroke:#e8590c,stroke-width:2px
