  G --> J(("Junior gets playbooks<br/>→ handles harder bugs"))
  G --> F(("Pre-flight check<br/>→ fewer review rounds"))
  G --> T(("Triage sends more<br/>work to cheap models"))
  G --> L(("Lead knows what is<br/>'not new' anymore<br/>→ fewer human pings"))
